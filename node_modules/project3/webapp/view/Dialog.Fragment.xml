<core:FragmentDefinition
xmlns="sap.m"
xmlns:core="sap.ui.core">

<Dialog title="Add payment Method">

<content>

<VBox>
<Button text="Google Pay" type="Emphasized" width="120px" press="onGpay" class="sapUiSmallMarginBottom"/>
<Button text="PhonePe" type="Default" width="120px" press="onPhonePe" class="sapUiSmallMarginBottom"/>
<Button text="AmazonPay" type="Accept" width="120px" press="onAmazonPay" class="sapUiSmallMarginBottom"/>
</VBox>
</content>

<endButton>
<Button text="close" press="onClose"/>


</endButton>
</Dialog>
</core:FragmentDefinition>