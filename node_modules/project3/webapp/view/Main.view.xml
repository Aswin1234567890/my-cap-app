<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="project3.controller.Main"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m">

    <tnt:ToolPage id="toolPage">

        <!-- LEFT SIDE NAVIGATION -->
        <tnt:sideContent>

            <tnt:SideNavigation id="_IDGenSideNavigation">

                <tnt:NavigationList id="_IDGenNavigationList"
                    itemSelect="onItemSelect">

                    
                    <tnt:NavigationListItem id="_IDGenNavigationListItem"
                        text="Home"
                        icon="sap-icon://home"
                        key="home"/>

                    <tnt:NavigationListItem id="_IDGenNavigationListItem1"
                        text="About Us"
                        icon="sap-icon://hint"
                        key="about"/>

                    <tnt:NavigationListItem id="_IDGenNavigationListItem2"
                        text="Sarees"
                        icon="sap-icon://product"
                        key="saree"/>

                    <tnt:NavigationListItem id="_IDGenNavigationListItem3" 
                    text="Offers"
                    icon="sap-icon://tags"
                    key="offers"/>

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <!-- MAIN CONTENT -->
        <tnt:mainContents>

            <Page
                id="mainPage"
                title="Sarees">

                <content>

                
                    <VBox
                        id="homeBox"
                        visible="true">

                        <!-- BANNER IMAGE -->
                        <!-- <Image id="_IDGenImage"
                            src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=1200&fit=crop"
                            width="100%"
                            height="300px"/> -->

                        <VBox id="_IDGenVBox" class="sapUiMediumMargin">

                        
                            <Title id="_IDGenTitle"
                                text="Welcome To Aswin Sarees"
                                level="H1"/>


                            <Text id="_IDGenText"
                                text="Premium Traditional Saree Collections. Explore our beautiful sarees."
                                class="sapUiSmallMarginTop"/>

                            <Button id="_IDGenButton"
                                text="Explore Collection"
                                type="Emphasized"
                                icon="sap-icon://navigation-right-arrow"
                                class="sapUiSmallMarginTop"
                                press="onExplorePress"/>

                        </VBox>

                        <HBox id="_IDGenHBox" class="sapUiMediumMargin" wrap="Wrap">

        <GenericTile id="_IDGenGenericTile1" header="Premium Quality"
            subheader="100% authentic handwoven"
            class="sapUiSmallMargin">
            <TileContent id="_IDGenTileContent">
                <ImageContent id="_IDGenImageContent" src="sap-icon://quality-issue"/>
            </TileContent>
        </GenericTile>

        <GenericTile id="_IDGenGenericTile2"
            header="Wide Collection"
            subheader="500+ sarees available"
            class="sapUiSmallMargin">
            <TileContent id="_IDGenTileContent1">
                <ImageContent id="_IDGenImageContent1" src="sap-icon://product"/>
            </TileContent>
        </GenericTile>

        <GenericTile id="_IDGenGenericTile3"
            header="Fast Delivery"
            subheader="Delivered to your doorstep"
            class="sapUiSmallMargin">
            <TileContent id="_IDGenTileContent2">
                <ImageContent id="_IDGenImageContent2" src="sap-icon://shipping-status"/>
            </TileContent>
        </GenericTile>

        <GenericTile id="_IDGenGenericTile4"
            header="Secure Payment"
            subheader="Multiple payment options"
            class="sapUiSmallMargin">
            <TileContent id="_IDGenTileContent3">
                <ImageContent id="_IDGenImageContent3" src="sap-icon://locked"/>
            </TileContent>
        </GenericTile>

        <GenericTile id="_IDGenGenericTile" header="Sarees Collections" subheader="contains all types of Sarees" 
        class="sapUiSmallMargin">
        <TileContent id="_IDGenTileContent4">
        <ImageContent id="_IDGenImageContent5" src="sap-icon://product"/>
    </TileContent></GenericTile>
    </HBox>
                    </VBox>

                    <!-- ABOUT SECTION -->
<VBox id="aboutBox" visible="false" class="sapUiMediumMargin">

    <Title id="_IDGenTitle1" text="About Us" level="H1"/>

    <Text id="_IDGenText1"
        text="Welcome to Aswin Sarees — your trusted destination for authentic, handcrafted Indian sarees. Established in the year 2000 in the heart of Coimbatore, Tamil Nadu, we have been proudly serving saree lovers across India for over 25 years. What started as a small family-run store has now grown into a well-known brand celebrated for its quality, variety, and customer trust."
        class="sapUiSmallMarginTop"/>

    <Text id="_IDGenText10"
        text="At Aswin Sarees, we believe that every saree tells a story — a story of culture, tradition, and the skilled hands that weave it. Our collections are carefully handpicked directly from master weavers across India, including the silk weavers of Kanchipuram, the Banarasi artisans of Varanasi, and the cotton weavers of Coimbatore. Each saree in our collection is a testament to the timeless artistry of Indian handloom."
        class="sapUiSmallMarginTop"/>

    <Text id="_IDGenText11"
        text="We take great pride in offering a wide range of sarees to suit every occasion — from grand weddings and festive celebrations to everyday wear. Whether you are looking for a rich Kanjivaram silk saree for your wedding day or a lightweight cotton saree for daily comfort, Aswin Sarees has something beautiful for every woman."
        class="sapUiSmallMarginTop"/>

    <Text id="_IDGenText12"
        text="Our mission goes beyond just selling sarees. We are deeply committed to supporting the handloom weaving community by working directly with artisans, ensuring they receive fair compensation for their incredible craft. By choosing Aswin Sarees, you are not just buying a saree — you are supporting a tradition, empowering a weaver, and keeping the heritage of Indian textiles alive for generations to come."
        class="sapUiSmallMarginTop"/>

    <Text id="_IDGenText13"
        text="Over the years, we have built a loyal community of more than 10,000 happy customers across 100+ cities in India. Our commitment to quality, transparency, and customer satisfaction has earned us the trust and love of families across generations. We are proud to be a brand that mothers pass on to their daughters."
        class="sapUiSmallMarginTop"/>

    <Text id="_IDGenText15"
        text="Thank you for choosing Aswin Sarees. We look forward to being a part of your most precious moments and celebrations. Step into our world of colours, traditions, and timeless elegance — because every woman deserves to feel beautiful."
        class="sapUiSmallMarginTop"/>

</VBox>

                    <Table
                        id="sareeTable"
                        items="{/Sarees}"
                        visible="false"
                        growing="true"
                        growingThreshold="5"
                        noDataText="No Sarees Available"
                        class="sapUiMediumMargin">

                        <headerToolbar>

                            <Toolbar id="_IDGenToolbar">

                                <Title id="_IDGenTitle2" text="Saree Collection"/>
<!-- 
                                <ToolbarSpacer id="_IDGenToolbarSpacer"/> -->


                                <SearchField id="_IDGenSearchField" width="200px" placeholder="Enter Saree Name" liveChange="onSearch"/>

                                <Button id="_IDGenButton3" text="Filter" press="onSort" width="100px"/>
                                

                                <!-- <ToolbarSpacer id="_IDGenToolbarSpacer1"/> -->

                            </Toolbar>

                        </headerToolbar>

                        <columns>

                            <Column id="_IDGenColumn">
                                <Text id="_IDGenText2" text="Image"/>
                            </Column>

                            <Column id="_IDGenColumn1">
                                <Text id="_IDGenText3" text="Name"/>
                            </Column>

                            <Column id="_IDGenColumn2">
                                <Text id="_IDGenText4" text="Price"/>
                            </Column>

                            <Column id="_IDGenColumn3">
                                <Text id="_IDGenText5" text="Description"/>
                            </Column>

                            <Column id="_IDGenColumn4">
                                <Text id="_IDGenText6" text="Stock"/>
                            </Column>

                            <Column id="_IDGenColumn5">
                                <Text id="_IDGenText7" text="Status"/>
                            </Column>

                            <Column id="_IDGenColumn6">
                                <Text id="_IDGenText8" text="Download"/>
                            </Column>

                            <Column id="_IDGenColumn7">
                                <Text id="_IDGenText9" text="Buy Now"/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem" >

                                <cells>

                                    <!-- IMAGE -->
                                    <Image id="_IDGenImage" 
                                        src="{Url}"
                                        width="100px"
                                        decorative="false"/>

                                    
                                    <Text id="_IDGenText16" text="{Name}"/>
                                                                    
                                    <Text id="_IDGenText17"  text="{Price}"/>

                                    <Text id="_IDGenText18" text="{Description}"/>

                                    
                                    <Text id="_IDGenText19"  text="{Stock}"/>

                            
                                    <ObjectStatus id="_IDGenObjectStatus"
                                        text="{Status}"
                                        state="Success"/>

                                    <Button id="_IDGenButton1" 
                                        text="Download"
                                        icon="sap-icon://download"
                                        press="onDownloadPress"/>

                                    
                                    <Button id="_IDGenButton2"
                                        text="Buy Now"
                                        icon="sap-icon://cart"
                                        type="Emphasized"
                                        press="onBuyNow"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>
                    
                <!-- OFFERS SECTION -->
<VBox id="offerBox" visible="false" class="sapUiMediumMargin">

    <Title id="_IDGenTitle3" text="Special Offers" level="H1"/>

    <Text id="_IDGenText21"
        text="Don't miss our exclusive saree offers! Buy 2 Sarees and Get 1 FREE on selected dates."
        class="sapUiSmallMarginTop"/>

    <Panel id="_IDGenPanel" headerText="🎉 Upcoming Offers"  expanded="true" class="sapUiSmallMarginTop">
        <VBox id="_IDGenVBox1" class="sapUiSmallMargin">
            <ObjectStatus id="_IDGenObjectStatus1" title="Summer Sale"        text="01 July 2026 - 07 July 2026"   state="Success"/>
            <ObjectStatus id="_IDGenObjectStatus2" title="Independence Day"   text="10 Aug 2026 - 15 Aug 2026"     state="Warning" class="sapUiSmallMarginTop"/>
            <ObjectStatus id="_IDGenObjectStatus3" title="Diwali Special"     text="15 Oct 2026 - 25 Oct 2026"     state="Error"   class="sapUiSmallMarginTop"/>
            <ObjectStatus id="_IDGenObjectStatus4" title="NewYear" text="20 Dec 2026 - 01 Jan 2027"  state="Information" class="sapUiSmallMarginTop"/>
        </VBox>
    </Panel>

    <Panel id="_IDGenPanel1" headerText="🛍️ Offer Details" expandable="true" expanded="true" class="sapUiSmallMarginTop">
        <VBox id="_IDGenVBox2" class="sapUiSmallMargin">
            <Text id="_IDGenText22" text=" Buy 2 Sarees → Get 1 Saree FREE"/>
            <Text id="_IDGenText23" text=" Flat 10% off on orders above ₹5000" class="sapUiSmallMarginTop"/>
            <Text id="_IDGenText24" text=" Free delivery on all orders during offer period" class="sapUiSmallMarginTop"/>
            <Text id="_IDGenText25" text=" Offer valid on selected sarees only" class="sapUiSmallMarginTop"/>
        </VBox>
    </Panel>

</VBox>
</content>

                <footer>

                    <Toolbar id="_IDGenToolbar1">

                        <ToolbarSpacer id="_IDGenToolbarSpacer2"/>

                        <Text id="_IDGenText14" text="© 2026 Aswin Sarees"/>

                        <ToolbarSpacer id="_IDGenToolbarSpacer3"/>

                    </Toolbar>

                </footer>

            </Page>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>

